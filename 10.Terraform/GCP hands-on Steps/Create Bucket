terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = "us-central1"
}

variable "project_id" {}

resource "google_storage_bucket" "demo" {
  name     = "${var.project_id}-tf-demo-bucket"
  location = "US"
}
